.venv/
__pycache__/
*.py[cod]

# Synthesized templates. Regenerated by `cdk synth`, and they contain resolved
# account ids, so they stay out of the repo.
cdk.out/
*.d.ts

# cdk.context.json caches account lookups (AZ names, AMI ids). Committing it is
# the documented practice for reproducible synth, but it pins values to one
# account - which is the opposite of this repo's goal of running anywhere.
cdk.context.json

.env
.idea/
.vscode/
